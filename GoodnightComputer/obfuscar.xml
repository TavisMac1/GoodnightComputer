<?xml version="1.0"?>
<Obfuscator>
  <Var name="InPath" value="@OUTDIR@" />
  <Var name="OutPath" value="@OUTDIR@Obfuscated" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="false" />
  <Var name="HideStrings" value="false" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="ReuseNames" value="true" />
  <Var name="XmlMapping" value="false" />
  <Var name="LogFile" value="@OUTDIR@Obfuscated\obfuscar-log.txt" />

  <Module file="$(InPath)GNC.dll">
    <!-- Avalonia XAML, compiled bindings and EF Core rely on type/member names -->
    <SkipNamespace name="GoodnightComputer.Views*" />
    <SkipNamespace name="GoodnightComputer.ViewModels*" />
    <SkipNamespace name="GoodnightComputer.Models*" />
    <SkipNamespace name="GoodnightComputer.Resources*" />
    <SkipType name="GoodnightComputer.App" />
    <SkipType name="GoodnightComputer.MainWindow" />
    <SkipType name="GoodnightComputer.Program" />
  </Module>
</Obfuscator>
