<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Models="using:GoodnightComputer.Models"
             xmlns:viewmodels="clr-namespace:GoodnightComputer.ViewModels"
             x:Class="GoodnightComputer.Views.SubViewItem"
             x:DataType="Models:PlaylistRecord"
             Background="#2D313A"
             Padding="16"
             Margin="8">
  <Border Background="#2D313A" 
          BorderBrush="MediumSpringGreen"
          BorderThickness="4"
          CornerRadius="8" 
          Padding="16">
    <StackPanel Spacing="1" Background="#2D313A">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="MediumSpringGreen" VerticalAlignment="Center"/>
        <Border Background="MediumSpringGreen"
                CornerRadius="4"
                Padding="8,2"
                IsVisible="{Binding IsActive}"
                VerticalAlignment="Center">
          <TextBlock Text="● Running" FontSize="11" FontWeight="Bold" Foreground="Black"/>
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding Descriptor}" FontSize="13" FontWeight="Bold" Foreground="CornflowerBlue"/>
      <TextBlock Text="{Binding CreatedOn}" FontSize="11" FontWeight="Bold" Foreground="CornflowerBlue"/>
      <!-- <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#808080"/> -->

      <Border Height="16"/>
      <Separator Height="2"/>
      <Border Height="16"/>

      <ScrollViewer Width="800" Height="200" HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Left" Background="#2D313A">
        <Grid ColumnDefinitions="*,8,*">
          <!-- Available Apps -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="Apps in Playlist"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="MediumSpringGreen"
                       Margin="0,0,0,8"/>
            <ListBox x:Name="AppsListBox" ItemsSource="{Binding ApplicationsList}" Height="180"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.Styles>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem">
                  <Setter Property="IsEnabled" Value="False"/>
                </Style>
              </ListBox.Styles>
            </ListBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <!-- Delete Button -->
      <Button Content="Delete Playlist"
            Command="{Binding DeleteFromDb}"
            Background="DarkRed"
            Foreground="White"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Width="140"
            Height="32"
            FontWeight="Bold"/>
      <Button Content="Sleep Apps"
            Command="{Binding SleepPlaylistApplications}"
            Background="MediumSpringGreen"
            Foreground="Black"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Width="140"
            Height="32"
            FontWeight="Bold"/>
    </StackPanel>
  </Border>
</UserControl>