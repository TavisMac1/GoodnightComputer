<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoodnightComputer.Controllers.ListAllAppsModal"
             Background="#80000000">
  <Grid>
    <Border Background="#23272F"
            CornerRadius="12"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="400">
      <StackPanel Spacing="16">
        <TextBlock Text="Select Apps to add to this schedule"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,8"/>
        <ListBox x:Name="AppsListBox"
                 SelectionMode="Multiple,Toggle"
                 Height="200"
                 Background="#2D313A"
                 Foreground="#FFFFFF"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="OK"
                  Width="80"
                  Click="OkButton_Click"
                  Background="#4F8EF7"
                  Foreground="#FFFFFF"/>
          <Button Content="Cancel"
                  Width="80"
                  Click="CancelButton_Click"
                  Background="#3A3F4B"
                  Foreground="#FFFFFF"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
