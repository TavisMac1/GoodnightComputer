<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewmodels="clr-namespace:GoodnightComputer.ViewModels" x:Class="GoodnightComputer.ViewModels.SettingsViewModel" x:DataType="viewmodels:SettingsViewModel" Background="Transparent"><ScrollViewer><StackPanel Spacing="24" Margin="32"><TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="MediumSpringGreen"/><Border Background="#2D313A" BorderBrush="MediumSpringGreen" BorderThickness="2" CornerRadius="10" Padding="24"><StackPanel Spacing="16"><TextBlock Text="Performance Scanner — CPU Threshold" FontSize="18" FontWeight="Bold" Foreground="MediumSpringGreen"/><TextBlock Text="When auto-creating a playlist from a scan, only apps whose average CPU usage exceeds this threshold (%) will be included. Raise the value to catch only heavy hitters; lower it to cast a wider net." FontSize="13" Foreground="CornflowerBlue" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,12,Auto"><TextBox x:Name="ThresholdInput" Grid.Column="0" Watermark="e.g. 5" Background="#3A3F4A" Foreground="White" BorderBrush="MediumSpringGreen" BorderThickness="1" CornerRadius="6" Padding="10,8"/><Button Grid.Column="2" Content="Save" Click="SaveThreshold_Click" Background="MediumSpringGreen" Foreground="Black" FontWeight="Bold" Padding="16,8" CornerRadius="6" HorizontalContentAlignment="Center"/></Grid></StackPanel></Border><Border Background="#2D313A" BorderBrush="MediumSpringGreen" BorderThickness="2" CornerRadius="10" Padding="24"><StackPanel Spacing="16"><TextBlock Text="App Exclusions" FontSize="18" FontWeight="Bold" Foreground="MediumSpringGreen"/><TextBlock Text="Apps added here will not appear in the app picker when creating a playlist." FontSize="13" Foreground="CornflowerBlue" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,12,Auto"><TextBox x:Name="ExclusionInput" Grid.Column="0" Watermark="Enter process name (e.g. discord)" Background="#3A3F4A" Foreground="White" BorderBrush="MediumSpringGreen" BorderThickness="1" CornerRadius="6" Padding="10,8"/><Button Grid.Column="2" Content="Add" Click="AddExclusion_Click" Background="MediumSpringGreen" Foreground="Black" FontWeight="Bold" Padding="16,8" CornerRadius="6" HorizontalContentAlignment="Center"/></Grid><ListBox x:Name="ExclusionsList" ItemsSource="{Binding UserExclusions}" Background="#3A3F4A" Height="200" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.Styles><Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#4A5260"/></Style><Style Selector="ListBoxItem"><Setter Property="Foreground" Value="White"/></Style></ListBox.Styles></ListBox><Button Content="Remove Selected" Click="RemoveExclusion_Click" Background="IndianRed" Foreground="White" FontWeight="Bold" Padding="14,8" CornerRadius="6" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
