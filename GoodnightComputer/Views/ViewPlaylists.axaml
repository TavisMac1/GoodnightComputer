<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:models="using:GoodnightComputer.Models"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GoodnightComputer.Views"
             xmlns:viewmodels="clr-namespace:GoodnightComputer.ViewModels"
             x:Class="GoodnightComputer.Views.ViewPlaylists"
             x:DataType="viewmodels:ViewPlaylistsViewModel"
             Background="Transparent"
             Padding="24">

    <Grid>
        <!-- Background Image -->
        <Image Source="avares://GNC/Assets/gcfinal.png"
               Stretch="None"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,24,24"
               Opacity="0.3"
               Width="300"
               Height="300"/>
        
        <!-- Main Content -->
        <StackPanel Spacing="24">
            <TextBlock Text="Your Playlists"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="MediumSpringGreen"
                       Margin="0,0,0,8"/>

            <Border Background="#2D313A" 
                    BorderBrush="#2D313A"
                    BorderThickness="3"
                    CornerRadius="8" 
                    Padding="12" 
                    Margin="0,8,0,0">
                <ScrollViewer Height="1000" VerticalScrollBarVisibility="Auto" Background="#2D313A">
                    <ListBox ItemsSource="{Binding PlaylistRecords}"
                             BorderThickness="0"
                             Background="#2D313A">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistRecord">
                                <views:SubViewItem/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Overlay when any playlist is active -->
        <Border Background="#DD000000"
                CornerRadius="0"
                IsVisible="{Binding IsAnyPlaylistActive}"
                ZIndex="1000">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Spacing="24">
                <!-- Icon -->
                <Image Source="avares://GNC/Assets/gcfinal.png"
                       Width="200"
                       Height="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>
                
                <!-- Message -->
                <TextBlock Text="Your applications are currently napping. . ."
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="500"/>
                
                <!-- Playlist Name -->
                <TextBlock Text="{Binding ActivePlaylist.Name, StringFormat='Playlist: {0}'}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="CornflowerBlue"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                
                <!-- Resume Button -->
                <Button Content="Resume Applications"
                        Command="{Binding ActivePlaylist.ResumePlaylistApplications}"
                        Background="MediumSpringGreen"
                        Foreground="Black"
                        FontSize="18"
                        Padding="20,14"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        MinWidth="250"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
