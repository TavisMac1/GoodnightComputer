<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:models="using:GoodnightComputer.Models"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GoodnightComputer.Views"
             xmlns:viewmodels="clr-namespace:GoodnightComputer.ViewModels"
             xmlns:services="clr-namespace:GoodnightComputer.Services"
             x:Class="GoodnightComputer.Views.ViewPlaylists"
             x:DataType="viewmodels:ViewPlaylistsViewModel"
             x:CompileBindings="False"
             Background="Transparent"
             Padding="24">

    <Grid>
        <!-- Background Image -->
        <Image Source="avares://GNC/Assets/gcfinal.png"
               Stretch="None"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,24,24"
               Opacity="0.3"
               Width="300"
               Height="300"/>
        
        <!-- Main Content -->
        <StackPanel Spacing="24">
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_Title]}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="MediumSpringGreen"
                       Margin="0,0,0,8"/>

            <Border Background="#2D313A" 
                    BorderBrush="#2D313A"
                    BorderThickness="3"
                    CornerRadius="8" 
                    Padding="12" 
                    Margin="0,8,0,0">
                <ScrollViewer Height="1000" VerticalScrollBarVisibility="Auto" Background="#2D313A">
                    <ListBox ItemsSource="{Binding PlaylistRecords}"
                             BorderThickness="0"
                             Background="#2D313A">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistRecord">
                                <views:SubViewItem/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Edit Playlist Modal -->
        <Border Background="#DD000000"
                CornerRadius="0"
                IsVisible="{Binding IsEditModalOpen}"
                ZIndex="2000">
            <Border Background="#2D313A"
                    BorderBrush="SteelBlue"
                    BorderThickness="3"
                    CornerRadius="12"
                    Padding="24"
                    MaxWidth="750"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_EditTitle]}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="MediumSpringGreen"/>
                    <TextBlock Text="{Binding EditingPlaylist.Name}"
                               FontSize="14"
                               Foreground="CornflowerBlue"
                               FontWeight="Bold"/>
                    <Separator/>

                    <!-- Search Bar -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="EditSearchTextBox"
                                 Width="220"
                                  Watermark="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common_Search]}"/>
                        <Button x:Name="EditSearchButton"
                                Background="MediumSpringGreen"
                                Foreground="Black"
                                MinWidth="60"
                                Height="30"
                                FontWeight="Bold"
                                Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common_Search]}"/>
                        <Button x:Name="EditRefreshButton"
                                Background="SlateGray"
                                Foreground="MediumSpringGreen"
                                MinWidth="60"
                                Height="30"
                                FontWeight="Bold"
                                Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common_Refresh]}"/>
                    </StackPanel>

                    <!-- Two-column app lists -->
                    <Grid ColumnDefinitions="*,8,*" Height="320">
                        <!-- Available Apps -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_AvailableApps]}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="MediumSpringGreen"
                                       Margin="0,0,0,4"/>
                            <ListBox x:Name="EditAvailableAppsListBox"
                                     ItemsSource="{Binding ModalAvailableApps}"
                                     Height="260"
                                     SelectionMode="Multiple"
                                     Padding="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ApplicationRecord">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="EditAddAppButton"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_AddButton]}"
                                    Background="MediumSpringGreen"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Width="100"
                                    Height="28"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Selected Apps -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_PlaylistApps]}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="MediumSpringGreen"
                                       Margin="0,0,0,4"/>
                            <ListBox x:Name="EditSelectedAppsListBox"
                                     ItemsSource="{Binding ModalSelectedApps}"
                                     Height="260"
                                     SelectionMode="Single"
                                     Padding="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ApplicationRecord">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="EditRemoveAppButton"
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_RemoveButton]}"
                                    Background="DarkRed"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,0,0"
                                    Width="100"
                                    Height="28"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Separator/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="EditCancelButton"
                                Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_CancelButton]}"
                                Command="{Binding CloseEditModalCommand}"
                                Background="SlateGray"
                                Foreground="White"
                                FontWeight="Bold"
                                Width="100"
                                Height="34"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                        <Button x:Name="EditSaveButton"
                                Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ViewPlaylists_SaveButton]}"
                                Background="MediumSpringGreen"
                                Foreground="Black"
                                FontWeight="Bold"
                                Width="140"
                                Height="34"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay when any playlist is active -->
        <Border Background="#DD000000"
                CornerRadius="0"
                IsVisible="{Binding IsAnyPlaylistActive}"
                ZIndex="1000">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Spacing="24">
                <!-- Icon -->
                <Image Source="avares://GNC/Assets/gcfinal.png"
                       Width="200"
                       Height="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>
                
                <!-- Message -->
                <TextBlock Text="Your applications are currently napping. . ."
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="500"/>
                
                <!-- Playlist Name -->
                <TextBlock Text="{Binding ActivePlaylist.Name, StringFormat='Playlist: {0}'}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="CornflowerBlue"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                
                <!-- Resume Button -->
                <Button Content="Resume Applications"
                        Command="{Binding ActivePlaylist.ResumePlaylistApplications}"
                        Background="MediumSpringGreen"
                        Foreground="Black"
                        FontSize="18"
                        Padding="20,14"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        MinWidth="250"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
