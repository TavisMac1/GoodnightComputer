<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModels="clr-namespace:GoodnightComputer.ViewModels"
             xmlns:Models="clr-namespace:GoodnightComputer.Models"
             xmlns:services="clr-namespace:GoodnightComputer.Services"
             x:Class="GoodnightComputer.ViewModels.CreatePlaylist"
             x:DataType="ViewModels:CreatePlaylist"
             Background="Transparent"
             Padding="24">
  <Grid>
    <!-- Background Image -->
    <Image Source="avares://GNC/Assets/gcfinal.png"
           Stretch="None"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,24,24"
           Opacity="0.3"
           Width="300"
           Height="300"/>
    
    <!-- Main Content -->
    <StackPanel Spacing="24">
      <!-- Header -->
      <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_Title]}"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="MediumSpringGreen"
                 Margin="20,0,0,0"/>

    <Separator/>
    <!-- App Selection -->
    <StackPanel>
       <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_AppsSectionTitle]}"
                 FontSize="16"
                 Foreground="MediumSpringGreen"
                 Margin="0,16,0,8"/>
      <Border  Background="#2D313A" 
              BorderBrush="#2D313A"
              BorderThickness="3"
              CornerRadius="8" 
              Padding="12">
        <StackPanel  Background="#2D313A">

        <StackPanel Margin="0,0,0,8">
          <TextBlock Margin="0 5" FontSize="14" FontWeight="Bold" Foreground="SteelBlue" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_PlaylistNameLabel]}"/>
          <TextBox x:Name="PlaylistNameTextBox" Watermark="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_PlaylistNamePlaceholder]}"/>
          <TextBlock  Margin="0 15 0 5" FontSize="14" FontWeight="Bold" Foreground="SteelBlue" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_DescriptionLabel]}"/>
          <TextBox x:Name="PlaylistDescriptionTextBox" Watermark="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_DescriptionPlaceholder]}"/>
        </StackPanel>

        <Separator Margin="20"/>
          <!-- Search Bar ABOVE the Grid -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" Background="#2D313A">
            <TextBox x:Name="SearchTextBox"
                     Width="200"
                     Watermark="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_SearchPlaceholder]}" />
            <Button Click="SearchApps_Click"
                    Background="MediumSpringGreen"
                    Foreground="Black"
                    MinWidth="60"
                    Height="30">
               <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common_Search]}" FontSize="14" FontWeight="Bold"/>
            </Button>
            <Button Click="Refresh_Click"
                    Background="SlateGray"
                    Foreground="MediumSpringGreen"
                    MinWidth="60"
                    Height="30"
                     ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_RefreshTooltip]}">
               <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Common_Refresh]}" FontSize="14" FontWeight="Bold"/>
            </Button>
          </StackPanel>
          <ScrollViewer Width="1000" Height="500" HorizontalScrollBarVisibility="Auto" Background="#2D313A" HorizontalAlignment="Left" Margin="16,10,0,0">
            <Grid ColumnDefinitions="*,8,*">
              <!-- Available Apps -->
              <StackPanel Grid.Column="0">
                 <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_AvailableApps]}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="AppsListBox" ItemsSource="{Binding ApplicationList}" Height="380" Padding="0,0,0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:ApplicationRecord">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                 <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_AddButton]}"
                        Click="AddAppToPlaylist_Click"
                        Background="MediumSpringGreen"
                        Foreground="Black"
                        FontSize="14"
                        Width="140"
                        Padding="6"
                        CornerRadius="1"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,8,0,0"
                        FontWeight="Bold"/>
              </StackPanel>
              <!-- Vertical Separator -->
              <Border Grid.Column="1"
                      Width="2"
                      Margin="12,0"
                      Background="#2D313A"
                      HorizontalAlignment="Center"/>
              <!-- Selected Apps -->
              <StackPanel Grid.Column="2">
                         <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_SelectedApps]}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="SelectedAppsListBox" ItemsSource="{Binding SelectedApps}" Height="380" Padding="0,0,0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:ApplicationRecord">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                 <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_RemoveButton]}"
                        Click="RemoveApp_Click"
                        Background="#781600"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        Width="180"
                        Padding="6"
                        CornerRadius="1"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,8,0,0"
                        FontWeight="Bold"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
           <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_HelpText]}"
                     Foreground="CornflowerBlue"
                     FontStyle="Italic"
                     FontSize="12"
                     FontWeight="Bold"
                     Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <!-- Save Button below the selection area -->
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
         <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CreatePlaylist_SaveButton]}"
                Click="SavePlaylist_Click"
                Background="MediumSpringGreen"
                Foreground="Black"
                FontSize="16"
                Padding="12"
                CornerRadius="1"
                FontWeight="Bold"
                HorizontalAlignment="Left"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </Grid>
</UserControl>