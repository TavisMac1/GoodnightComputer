<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModels="clr-namespace:GoodnightComputer.ViewModels"
             xmlns:Models="clr-namespace:GoodnightComputer.Models"
             x:Class="GoodnightComputer.ViewModels.CreatePlaylist"
             x:DataType="ViewModels:CreatePlaylist"
             Background="#23272F"
             Padding="24"
             >
  <StackPanel Spacing="24">
    <!-- Header -->
    <TextBlock Text="Create a New Playlist"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#FFFFFF"
               Margin="0,0,0,8"/>

    <StackPanel Margin="20">
      <TextBlock
         Margin="0 5"
         x:Name="ErrorMessageTextBlock"
         Foreground="Red"
         FontWeight="Bold">
      </TextBlock>

      <TextBlock Margin="0 5">Playlist Name</TextBlock>
      <TextBox x:Name="PlaylistNameTextBox" Watermark="Enter a name for your Playlist"/>

      <TextBlock Margin="0 15 0 5" x:Name="PlaylistDescriptionTextBlock">Description</TextBlock>
      <TextBox x:Name="PlaylistDescriptionTextBox" Watermark="Enter a description for your Playlist"/>

    </StackPanel>

    <!-- App Selection -->
    <StackPanel>
      <TextBlock Text="Apps for your Playlist to Sleep:"
                 FontSize="16"
                 Foreground="#FFFFFF"
                 Margin="0,16,0,8"/>
      
  <Border Background="#2D313A" CornerRadius="8" Padding="12">
    <StackPanel>
      <ScrollViewer Width="800" Height="300" HorizontalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,*">
          <!-- Available Apps -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="Available Apps"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#B0B0B0"
                       Margin="0,0,0,8"/>
            <ListBox x:Name="AppsListBox" ItemsSource="{Binding ApplicationList}" Height="220">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="Models:ApplicationRecord">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <!-- Selected Apps -->
          <StackPanel Grid.Column="1">
            <TextBlock Text="Selected Apps"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#B0B0B0"
                       Margin="0,0,0,8"/>
            <ListBox x:Name="SelectedAppsListBox" ItemsSource="{Binding SelectedApps}" Height="220">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="Models:ApplicationRecord">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <TextBlock Text="Select apps to add to your playlist by clicking on them."
                 Foreground="#FFFFFF"
                 Margin="0,8,0,0"/>
    </StackPanel>
  </Border>
    <Button Content="Add App to Playlist"
            Click="AddAppToPlaylist_Click"
            Background="#4F8EF7"
            Foreground="#FFFFFF"
            FontSize="16"
            Padding="12"
            CornerRadius="8"
            HorizontalAlignment="Left"
            Margin="0,16,0,0"/>
    </StackPanel>

    <!-- Save Button -->
    <Button Content="Save Playlist"
            Click="SavePlaylist_Click"
            Background="#4F8EF7"
            Foreground="#FFFFFF"
            FontSize="16"
            Padding="12"
            CornerRadius="8"
            HorizontalAlignment="Right"
            Margin="0,24,0,0"/>
  </StackPanel>
</UserControl>