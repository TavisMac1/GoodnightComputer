<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ViewModels="clr-namespace:GoodnightComputer.ViewModels"
             xmlns:Models="clr-namespace:GoodnightComputer.Models"
             x:Class="GoodnightComputer.ViewModels.CreatePlaylist"
             x:DataType="ViewModels:CreatePlaylist"
             Background="Transparent"
             Padding="24">
  <Grid>
    <!-- Background Image -->
    <Image Source="avares://GNC/Assets/gcfinal.png"
           Stretch="None"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,24,24"
           Opacity="0.3"
           Width="300"
           Height="300"/>
    
    <!-- Main Content -->
    <StackPanel Spacing="24">
      <!-- Header -->
      <TextBlock Text="Create New Playlist"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="MediumSpringGreen"
                 Margin="20,0,0,0"/>

    <Separator/>
    <!-- App Selection -->
    <StackPanel>
      <TextBlock Text="Apps for your Playlist to Sleep"
                 FontSize="16"
                 Foreground="MediumSpringGreen"
                 Margin="0,16,0,8"/>
      <Border  Background="#2D313A" 
              BorderBrush="#2D313A"
              BorderThickness="3"
              CornerRadius="8" 
              Padding="12">
        <StackPanel  Background="#2D313A">

        <StackPanel Margin="0,0,0,8">
          <TextBlock Margin="0 5" FontSize="14" FontWeight="Bold" Foreground="SteelBlue">Playlist Name</TextBlock>
          <TextBox x:Name="PlaylistNameTextBox" Watermark="Enter a name for your Playlist"/>
          <TextBlock  Margin="0 15 0 5" FontSize="14" FontWeight="Bold" Foreground="SteelBlue">Description</TextBlock>
          <TextBox x:Name="PlaylistDescriptionTextBox" Watermark="Enter a description for your Playlist"/>
        </StackPanel>

        <Separator Margin="20"/>
          <!-- Search Bar ABOVE the Grid -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" Background="#2D313A">
            <TextBox x:Name="SearchTextBox"
                     Width="200"
                     Watermark="Search applications..." />
            <Button Click="SearchApps_Click"
                    Background="MediumSpringGreen"
                    Foreground="Black"
                    MinWidth="60"
                    Height="30">
              <TextBlock Text="Search" FontSize="14" FontWeight="Bold"/>
            </Button>
            <Button Click="Refresh_Click"
                    Background="SlateGray"
                    Foreground="MediumSpringGreen"
                    MinWidth="60"
                    Height="30"
                    ToolTip.Tip="Refresh app list (applies exclusion changes)">
              <TextBlock Text="↻ Refresh" FontSize="14" FontWeight="Bold"/>
            </Button>
          </StackPanel>
          <ScrollViewer Width="1000" Height="500" HorizontalScrollBarVisibility="Auto" Background="#2D313A" HorizontalAlignment="Left" Margin="16,10,0,0">
            <Grid ColumnDefinitions="*,8,*">
              <!-- Available Apps -->
              <StackPanel Grid.Column="0">
                <TextBlock Text="Available Apps"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="AppsListBox" ItemsSource="{Binding ApplicationList}" Height="380" Padding="0,0,0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:ApplicationRecord">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Add to Playlist"
                        Click="AddAppToPlaylist_Click"
                        Background="MediumSpringGreen"
                        Foreground="Black"
                        FontSize="14"
                        Width="140"
                        Padding="6"
                        CornerRadius="1"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,8,0,0"
                        FontWeight="Bold"/>
              </StackPanel>
              <!-- Vertical Separator -->
              <Border Grid.Column="1"
                      Width="2"
                      Margin="12,0"
                      Background="#2D313A"
                      HorizontalAlignment="Center"/>
              <!-- Selected Apps -->
              <StackPanel Grid.Column="2">
                <TextBlock Text="Selected Apps"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="MediumSpringGreen"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="SelectedAppsListBox" ItemsSource="{Binding SelectedApps}" Height="380" Padding="0,0,0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:ApplicationRecord">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Remove App"
                        Click="RemoveApp_Click"
                        Background="#781600"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        Width="180"
                        Padding="6"
                        CornerRadius="1"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,8,0,0"
                        FontWeight="Bold"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <TextBlock Text="Select apps to add to your playlist by clicking on them."
                     Foreground="CornflowerBlue"
                     FontStyle="Italic"
                     FontSize="12"
                     FontWeight="Bold"
                     Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <!-- Save Button below the selection area -->
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
        <Button Content="Save Playlist"
                Click="SavePlaylist_Click"
                Background="MediumSpringGreen"
                Foreground="Black"
                FontSize="16"
                Padding="12"
                CornerRadius="1"
                FontWeight="Bold"
                HorizontalAlignment="Left"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </Grid>
</UserControl>