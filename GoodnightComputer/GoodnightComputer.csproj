<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <StartupObject>GoodnightComputer.Program</StartupObject>
    <AssemblyName>GNC</AssemblyName>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Copyright>Copyright Fennec Branta, 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Configurations>Debug;Release;RELEASE-STEAM;RELEASE-BETA;RELEASE-BETA-STEAM</Configurations>
    <ErrorReport>none</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RELEASE-STEAM|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RELEASE-BETA|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RELEASE-BETA-STEAM|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <!-- Add constants based on build type -->
  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-STEAM'">
    <DefineConstants>$(DefineConstants);STEAMBUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-BETA-STEAM'">
    <DefineConstants>$(DefineConstants);STEAMBUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-BETA'">
    <DefineConstants>$(DefineConstants);RELEASEBETA</DefineConstants>
  </PropertyGroup>
  
  
  <!-- Exclude files from Steam build -->
  <ItemGroup Condition="'$(Configuration)'=='RELEASE-STEAM'">
    <Compile Remove="Constants\ConstantsAzure.cs" />
    <!--<Compile Remove="ViewModels\SignInViewModel.cs" /> -->
  </ItemGroup>

  <!-- Exclude files from Steam Beta Build -->
  <ItemGroup Condition="'$(Configuration)'=='RELEASE-BETA-STEAM'">
    <Compile Remove="Constants\ConstantsAzure.cs" />
  </ItemGroup>

  <!-- Configure output paths based on build type -->
  <!-- Steam Based Build Production Release-->
  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-STEAM'">
    <OutputPath>bin\STEAMPROD\</OutputPath>
  </PropertyGroup>
  
  <!-- Steam Based Beta Build -->
  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-BETA-STEAM'">
    <OutputPath>bin\STEAMBETA\</OutputPath>
  </PropertyGroup>

  <!-- Normal Non Steam Based Beta Build -->
  <PropertyGroup Condition="'$(Configuration)'=='RELEASE-BETA'">
    <OutputPath>bin\BETANORMAL\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\gcfinal.png" />
    <AvaloniaResource Include="Assets\favicon.ico" />
    <AvaloniaResource Include="Assets\gnc_art_cropped.PNG" />
  </ItemGroup>

  <!-- Include localization JSON files -->
  <ItemGroup>
    <LocalizationFiles Include="Resources\Localization\*.json" />
  </ItemGroup>

  <Target Name="CopyLocalizationFiles" AfterTargets="Build">
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="$(TargetDir)Resources\Localization\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AvaloniaToaster" Version="1.1.51" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.6" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.67.0" />
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\ValidationModels\" />
  </ItemGroup>

  <!-- Copy native Steamworks DLL to output for Steam builds -->
  <ItemGroup Condition="'$(Configuration)'=='RELEASE-STEAM' Or '$(Configuration)'=='RELEASE-BETA-STEAM'">
    <None Include="$(MSBuildProjectDirectory)\steam_api64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>steam_api64.dll</Link>
    </None>
  </ItemGroup>
</Project>
