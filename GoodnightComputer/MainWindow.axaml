<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:GoodnightComputer.Services"
        x:Class="GoodnightComputer.MainWindow"
        x:CompileBindings="False"
        Title="{Binding [AppTitle]}"
        Width="1920"
        Height="1080"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur"
        Background="Transparent"
        Icon="avares://GNC/Assets/favicon.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" 
            x:Name="Sidebar"
            Width="220"
            Background="#1E2128"
            BorderBrush="#3AFD7A22"
            BorderThickness="0,0,1,0"
            Padding="0,16,0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" HorizontalAlignment="Stretch">

          <!-- App Title -->
          <Border Padding="16,8,16,20">
            <Image Source="avares://GNC/Assets/gnc_art_cropped.PNG"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>
          </Border>

          <Separator Margin="16,0,16,8" Background="#3AFFFFFF"/>

          <Button x:Name="ViewPlaylistsButton"
                  Click="NewViewPlaylistsView_Click"
                  Content="{Binding [Nav_ViewPlaylists]}"
                  Background="SlateGray"
                  Foreground="MediumSpringGreen"
                  FontSize="16"
                  FontWeight="Bold"
                  Padding="12"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="12,0"/>

          <Button x:Name="PlaylistButton"
                  Click="NewPlaylistView_Click"
                  Content="{Binding [Nav_CreatePlaylist]}"
                  Background="SlateGray"
                  Foreground="MediumSpringGreen"
                  FontSize="16"
                  FontWeight="Bold"
                  Padding="12"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="12,0"/>

          <Button x:Name="PerformanceScanButton"
                  Click="OpenPerformanceScan_Click"
                  Content="{Binding [Nav_PerformanceScan]}"
                  Background="SlateGray"
                  Foreground="MediumSpringGreen"
                  FontSize="16"
                  FontWeight="Bold"
                  Padding="12"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="12,0"/>

          <Button x:Name="SteamStatusButton"
                  Click="OpenSteamStatus_Click"
                  Content="{Binding [Nav_Steam]}"
                  Background="SlateGray"
                  Foreground="MediumSpringGreen"
                  FontSize="16"
                  FontWeight="Bold"
                  Padding="12"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="12,0"/>

          </StackPanel>

        <!-- Settings pinned to bottom -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" HorizontalAlignment="Stretch">
          <Separator Margin="16,0,16,8" Background="#3AFFFFFF"/>
          <Button x:Name="SettingsButton"
                  Click="OpenSettings_Click"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="16,14"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Center"
                  Margin="8,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock x:Name="SettingsText" Text="{Binding [Nav_Settings]}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="DiscordButton"
                  Click="OpenDiscord_Click"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="16,14"
                  CornerRadius="8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Center"
                  Margin="8,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="💬" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock x:Name="DiscordText" Text="{Binding [Nav_Discord]}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Border/>
      </DockPanel>
    </Border>

    <!-- Toggle Button on Divider -->
    <Button Grid.Column="1"
            x:Name="ToggleSidebarButton"
            Click="ToggleSidebar_Click"
            Background="MediumSpringGreen"
            Foreground="Black"
            Width="20"
            Height="120"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            CornerRadius="0,12,12,0"
            Padding="0"
            FontWeight="Bold"
            FontSize="14"
            Content="◀"
            ToolTip.Tip="{Binding [Nav_ToggleSidebar]}"/>

    <!-- Main Content Area -->
    <Border Grid.Column="2" Background="Transparent" CornerRadius="12,0,0,12" Margin="0,0,0,0">
      <ContentControl x:Name="MainContent"/>
    </Border>

    <!-- Loading Overlay -->
    <Border x:Name="LoadingOverlay"
            Grid.ColumnSpan="3"
            Background="#80000000"
            IsVisible="False"
            ZIndex="100">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="100" Height="8"/>
        <TextBlock Text="{Binding [Common_Loading]}" 
                   Foreground="MediumSpringGreen" 
                   FontWeight="Bold"
                   Margin="0,12,0,0" 
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Panel x:Name="ToastContainer"
        Grid.ColumnSpan="3"
        ZIndex="1000"
        IsHitTestVisible="False"
    />
  </Grid>
</Window>


