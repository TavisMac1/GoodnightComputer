<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GoodnightComputer.MainWindow"
        Title="Goodnight Computer"
        Width="1920"
        Height="1080"
        Background="PaleVioletRed">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Background Image (Placed First, behind everything) -->
    <Image Grid.Column="2"
           Source="avares://GNC/Assets/gcfinal.png"
           Stretch="None"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,24,24"
           Opacity="0.3"
           Width="300"
           Height="300"/>

    <!-- Sidebar -->
    <Border Grid.Column="0" 
            x:Name="Sidebar"
            Width="180"
            Background="#2D313A" 
            BorderBrush="MediumSpringGreen"
            BorderThickness="0,0,3,0"
            CornerRadius=""  
            Padding="0,24,0,0">
      <StackPanel VerticalAlignment="Top" Spacing="20" HorizontalAlignment="Stretch">
        <!-- Sidebar Header -->
        <TextBlock Text=""
                   Foreground="MediumSpringGreen"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"
                   />
        
        <Button x:Name="ViewPlaylistsButton"
                Click="NewViewPlaylistsView_Click"
                Content="View Playlists"
                Background="SlateGray"
                Foreground="MediumSpringGreen"
                FontSize="16"
                FontWeight="Bold"
                Padding="12"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="12,0"/>
        <Button x:Name="PlaylistButton"
                Click="NewPlaylistView_Click"
                Content="Create Playlist"
                Background="SlateGray"
                Foreground="MediumSpringGreen"
                FontSize="16"
                FontWeight="Bold"
                Padding="12"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="12,0"/>
        <Button Content="Discord"
                Click="OpenDiscord_Click"
                Background="SlateGray"
                Foreground="MediumSpringGreen"
                FontSize="16"
                FontWeight="Bold"
                Padding="12"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="12,0"/>
      </StackPanel>
    </Border>

    <!-- Toggle Button on Divider -->
    <Button Grid.Column="1"
            x:Name="ToggleSidebarButton"
            Click="ToggleSidebar_Click"
            Background="MediumSpringGreen"
            Foreground="Black"
            Width="24"
            Height="60"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            CornerRadius="0,12,12,0"
            Padding="0"
            FontWeight="Bold"
            FontSize="16"
            Content="◀"
            ToolTip.Tip="Toggle Sidebar"/>

    <!-- Main Content Area -->
    <Border Grid.Column="2" Background="Transparent" CornerRadius="12,0,0,12" Margin="0,0,0,0">
      <ContentControl x:Name="MainContent"/>
    </Border>

    <!-- Loading Overlay -->
    <Border x:Name="LoadingOverlay"
            Grid.ColumnSpan="3"
            Background="#80000000"
            IsVisible="False"
            ZIndex="100">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="100" Height="8"/>
        <TextBlock Text="Loading..." 
                   Foreground="MediumSpringGreen" 
                   FontWeight="Bold"
                   Margin="0,12,0,0" 
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Panel x:Name="ToastContainer"
        Grid.ColumnSpan="3"
        ZIndex="1000"
        IsHitTestVisible="False"
    />
  </Grid>
</Window>
